#!/usr/bin/env sh
# Runs the Rails server and the Dart Sass watcher together.
# On Windows without a POSIX shell, run these two commands in separate terminals:
#   bin/rails dartsass:watch
#   bin/rails server
if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
