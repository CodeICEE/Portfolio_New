<!DOCTYPE html>
<html>
  <head>
    <title>Vladimir Joseph</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Bootstrap 5 - CSS only. This app uses .btn/.btn-lg and Reboot's resets;
        it uses none of Bootstrap's JavaScript components. %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">

    <%# Compiled by dartsass-rails from app/assets/stylesheets/application.scss
        into app/assets/builds/application.css, then fingerprinted by Propshaft. %>
    <%= stylesheet_link_tag "application", media: "all" %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Oswald:wght@200;300;400;500;600;700&family=Rock+Salt&display=swap" rel="stylesheet">

    <script src="https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.js"></script>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.9.1/mapbox-gl.css" rel="stylesheet" />

    <script src="https://kit.fontawesome.com/d187cd9d62.js" crossorigin="anonymous"></script>
  </head>

  <body>
    <div id="main">
      <%= yield %>
    </div>
    <%= render "shared/footer" %>
  </body>
</html>
