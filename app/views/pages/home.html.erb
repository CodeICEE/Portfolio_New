<main>
<section id="hero" >
<div class="content-column">
    <div class="content-column-inner">
        <%= render"shared/heronav" %>
        <div id="hero-info-container">
            <div class="hero-info hero-left" >
                <p class="hero-alert">open to front-end roles · remote or Central FL</p>
                <h1 class="hero-text">Vladimir<br>Joseph</h1>
                <h2 class ="hero-subtext">Front-End web developer</h2>
                <p class="hero-desc"> Four years turning designer handoffs — Figma and Adobe XD — into responsive, maintainable front-ends with HTML, CSS, JavaScript, and WordPress. </p>
                <div id= "hero-buttons">
                <!-- Two different ways to do buttons in RoR -->
                <%= link_to "./resume.pdf", "/Vladimir_Joseph_Resume_2026_no_contact.pdf", :target => "_blank", class: "btn btn-custom-2" %>
                <!-- <a href= <%= projects_show_path%> class="btn btn-custom-2">./view-work</a> -->
                </div>
            </div>
            <div class="hero-info hero-right">
                <div id="hero-stack-wrapper">
                    <div id="hero-stack">
                        <div id="stack-scanner"></div>
                        <div class="hero-stack-top">
                            <div class="stack-browser-buttons-wrapper">
                                <div class="stack-browser-button"></div>
                                <div class="stack-browser-button"></div>
                                <div class="stack-browser-button"></div>
                            </div>
                            <p>stack.rb</p>
                        </div>
                        <div class="hero-stack-main">
                            <p> 
                                <p><span class="stack-li">1</span> <span class="stack-highlight">def</span> stack </p>
                                <p><span class="stack-li">2</span> <span class="muted-text">build: [</span>"HTML", "CSS", "JavaScript"<span class="muted-text">],</span></p>
                                <p><span class="stack-li">3</span> <span class="muted-text">server: [</span>"Ruby on Rails", "WordPress"<span class="muted-text">],</span></p>
                                <p><span class="stack-li">4</span> <span class="muted-text">ship: [</span>"Git", "GitHub"],</p>
                                <p><span class="stack-li">5</span> <span class="muted-text">design: [</span>"Affinity Designer", "Photoshop"<span class="muted-text">]</span></p>
                                <p><span class="stack-li">6</span> <span class="stack-highlight">end</span></p>
                            </p>
                        </div>
                        <div class="hero-stack-bottom">
                            <p>→ 4 years professional · 3 shipped projects</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    <%# <div id="arrow">
        <div id="arrow1"></div>
        <div id="arrow2"></div>
    </div> %>
</section>

<section id="projects-section">
<div class="content-column">
    <div class="content-column-inner">
    <h2 class = "section-head"> Things I've Shipped </h2>
        <div class="projects-container">
            <div class="single-project">
                <a href=<%= projects_mightylocksmith_path%>>
                    <div id="project-2" class="project-image"></div>
                    <div class="project-data">
                        <p class="project-tools-used"> Wordpress &middot; HTML/CSS</p>
                        <h3 class="project-title">Mighty Locksmith LLC</h3>
                        <p class="project-desc mobile">A buisness Website created for Mighty Locksmith LLC. Built with Wordpress and some custom html and css.</p>
                                              <%#  <a href="https://www.mightylocksmith.com" target="blank" class="btn btn-lg btn-custom-1">View Site</a> %>

                    </div>
                </a>
            </div>
            <div class="single-project">
                <a href=<%= projects_fafsa_path%>>
                    <div id="project-3" class="project-image"></div>
                    <div class="project-data">
                        <p class="project-tools-used"> Ruby on Rails &middot; CRUD &middot; Git &middot; Github</p>
                        <h3 class="project-title">FafsaLAB</h3>
                        <p class="project-desc mobile">A concept website for helping students with their FAFSA featuring CRUD functionality. Built with ruby/ruby on rails.</p>
                        <p class="project-links">
                            <a href="https://github.com/CodeICEE/FAFSA-Like-a-Boss" target="blank">Code</a>,
                            <a href="https://www.youtube.com/watch?v=yeB8iAmddJk" target="blank">Demo</a>
                        </p>
                    </div>
                </a>
            </div>
            <div class="single-project">
                <a href=<%= projects_portfolio_path%>>
                    <div id="project-1" class="project-image"></div>
                    <div class="project-data">
                        <p class="project-tools-used"> Ruby on Rails &middot; Html &middot; Css &middot; Git &middot; Github</p>
                        <h3 class="project-title">Portfolio</h3>
                        <p class="project-desc mobile">This portfolio website made to display my work and skills. Built with Ruby/Ruby on rails. HTML, CSS, and Javascript. </p>
                        <p class="project-links">
                            <a href="https://github.com/CodeICEE/Portfolio_New" target="blank">Source on Github</a>,
                        </p>
                    </div>
                </a>
            </div>
        </div>
    </div >
</div >
</section>

<section id="skills-section">
    <p class="faded-text align-left"> < </p>
    <h2 class = "section-head"> - Skills - </h2>
    <div class="skills-container">
        <%= image_tag "skills-icons/HTML5_logo_and_wordmark.svg", alt: "logo icon for HTML5", class: "skill-logo" %>
        <%= image_tag "skills-icons/CSS3_logo_and_wordmark.svg", alt: "logo icon for CSS3", class: "skill-logo" %>
        <%= image_tag "skills-icons/Unofficial_JavaScript_logo_2.svg", alt: "logo icon for Javascript", class: "skill-logo" %>
        <%= image_tag "skills-icons/Git-logo-orange.svg", alt: "logo icon for git", class: "skill-logo" %>
        <%= image_tag "skills-icons/Github-desktop-logo-symbol.svg", alt: "logo icon for GitHub", class: "skill-logo" %>
        <%= image_tag "skills-icons/WordPress_logo.svg", alt: "logo icon for WordPress", class: "skill-logo" %>
        <%= image_tag "skills-icons/Ruby_logo.svg", alt: "logo icon for Ruby", class: "skill-logo" %>
        <%= image_tag "skills-icons/Ruby_On_Rails_Logo.svg", alt: "logo icon for Ruby on Rails", class: "skill-logo" %>
        <%= image_tag "skills-icons/Affinity_Designer_Logo.svg", alt: "logo icon for Affinity Designer", class: "skill-logo" %>
        <%# image_tag "skills-icons/Photoshop_Logo.svg", alt: "logo icon for Photoshop", class: "skill-logo" %>
    </div>
    <p class="faded-text align-right"> / > </p>
</section>

<section id="contact">

</section>
</main>

